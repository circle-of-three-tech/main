# Local development. Never commit this file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=verify-full"
AUTH_SECRET="generate-with: openssl rand -base64 48"
NEXT_PUBLIC_SITE_URL="https://circleofthreetech.com"

# Seeded admin account (change the password after first login)
ADMIN_EMAIL="circleofthreetechnologies@gmail.com"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_NAME="Co3 Admin"

# Optional: Vercel Blob for image uploads (falls back to /public/uploads locally)
BLOB_READ_WRITE_TOKEN=""
# Optional: SMTP for transactional email (nodemailer). Contact enquiries are emailed
# to CONTACT_NOTIFY_EMAIL (or the dashboard Settings email) and the sender gets an
# acknowledgement. Gmail: smtp.gmail.com, port 465, and an App Password (not your login password).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE=""            # defaults to true on port 465, STARTTLS otherwise
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""              # e.g. "Circle of Three Technologies" <hello@yourdomain.com>; defaults to SMTP_USER
CONTACT_NOTIFY_EMAIL=""
# Optional: search console verification
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
# Optional: salt for the cookie-free analytics visitor hash (falls back to AUTH_SECRET)
ANALYTICS_SALT=""
